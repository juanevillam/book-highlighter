{
  "name": "book-highlighter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "eval:photos": "tsx scripts/eval-photos.ts",
    "build": "tsc --noEmit && vite build",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name=bookhighlighter --branch=main --commit-dirty=true",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:web-ui": "node ../scripts/sync-web-ui.mjs --from book",
    "check:web-ui": "node ../scripts/sync-web-ui.mjs --check"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "onnxruntime-node": "1.23.2",
    "prettier": "3.8.3",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "jspdf": "4.2.1",
    "onnxruntime-web": "1.23.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "5.0.13"
  }
}

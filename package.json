{
  "name": "book-highlighter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "vite",
    "dev:scanner": "cd scanner && .venv/bin/uvicorn server:app --host 0.0.0.0 --port 8787 --reload",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "jspdf": "4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zustand": "5.0.13"
  }
}
